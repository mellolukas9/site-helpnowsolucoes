# HelpNow — Apache (HostGator)
Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1) HTTPS e domínio sem www
  RewriteCond %{HTTPS} off [OR]
  RewriteCond %{HTTP_HOST} ^www\. [NC]
  RewriteRule ^ https://helpnowsolucoes.com.br%{REQUEST_URI} [L,R=301]

  # 2) .html → URL limpa (ex.: /agendamento.html → /agendamento)
  RewriteCond %{THE_REQUEST} \s/+((?!index|404)[a-z0-9-]+)\.html[\s?] [NC]
  RewriteRule ^ /%1 [R=301,L,QSA]

  # 3) URL limpa → arquivo .html
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^([a-z0-9-]+)/?$ $1.html [L,NC]

  # 4) Bloqueia qualquer .php fora de /api/
  RewriteCond %{REQUEST_URI} \.php$ [NC]
  RewriteCond %{REQUEST_URI} !^/api/agenda\.php$ [NC]
  RewriteRule ^ - [F,L]
</IfModule>

# Arquivos que nunca devem ser servidos
<FilesMatch "^(\.|.*\.(md|log|sample|bak|sql)$)">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(html)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|svg|png|jpg|webp|woff2)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>
